# Ollama: 설치한 모델 태그를 지정. 네이티브 API 주소이므로 /v1은 붙이지 않는다.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# 비우면 공급자 기본 주소를 사용한다.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# OpenAI 전송 재시도 횟수. Ollama 재시도는 이후 워크플로에서 처리한다.
LLM_MAX_RETRIES=1
# 모델이 temperature를 지원할 때만 지정한다. 비우면 전달하지 않는다.
LLM_TEMPERATURE=

# 비우면 LLM_MODEL 사용. 공급자는 모든 역할에서 공통이다.
LLM_EXTRACT_MODEL=
LLM_RETRIEVE_MODEL=
LLM_JUDGE_MODEL=
LLM_VERIFY_MODEL=

# OpenAI 사용 시 LLM_PROVIDER=openai, LLM_MODEL=사용할 모델명으로 변경.
# LLM_BASE_URL도 비우거나 OpenAI API 주소로 변경한다.
OPENAI_API_KEY=

# LLM 설정과 독립. 임베딩 호출은 아직 구현하지 않았다.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
