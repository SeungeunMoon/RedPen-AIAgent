# 터미널 환경변수가 이 파일보다 우선한다. 실제 값은 .env에 설정한다.
# 채팅 모델(LLM_PROVIDER/LLM_MODEL)과 임베딩 설정은 서로 독립적이다.
LLM_NUM_CTX=16384
OPENAI_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_MAX_RETRIES=1

# docker/compose.yml의 로컬 개발 DB 기본값
PGVECTOR_CONNECTION=postgresql+psycopg://redpen:redpen@127.0.0.1:5433/redpen

REGULATION_PROVIDER=rag
RAG_TOP_K=4
RAG_MAX_CHUNKS=12
RAG_SEARCH_METHOD=dense

# RAGAS 평가 전용 OpenAI judge. 서비스의 LLM_JUDGE_MODEL과 별개다.
RAGAS_MODEL=gpt-4o-mini
RAGAS_BASE_URL=https://api.openai.com/v1
RAGAS_TIMEOUT_SECONDS=60
RAGAS_METRIC_TIMEOUT_SECONDS=180
RAGAS_MAX_RETRIES=1
# 비어 있으면 위의 OPENAI_API_KEY를 사용한다.
RAGAS_OPENAI_API_KEY=
