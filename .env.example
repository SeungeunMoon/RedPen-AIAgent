# 터미널 환경변수가 이 파일보다 우선한다. 실제 값은 .env에 설정한다.
# 채팅 모델(LLM_PROVIDER/LLM_MODEL)과 임베딩 설정은 서로 독립적이다.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_MAX_RETRIES=1

# docker/compose.yml의 로컬 개발 DB 기본값
PGVECTOR_CONNECTION=postgresql+psycopg://redpen:redpen@127.0.0.1:5433/redpen
